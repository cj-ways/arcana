{
  "name": "deep-review-unsafe-diff",
  "skill": "deep-review",
  "description": "Review a branch diff that introduces a concrete high-severity refund bug.",
  "workdir": "repo",
  "setupCommands": [
    "cp -R ../setup/base/. .",
    "git init",
    "git branch -M main",
    "git config user.email 'eval@example.com'",
    "git config user.name 'Arcana Eval'",
    "git add .",
    "git commit -m 'base'",
    "git checkout -b feature/unsafe-refund-update",
    "cp -R ../setup/head/. .",
    "git add .",
    "git commit -m 'rewrite refund update flow'"
  ],
  "prompt": "Run /deep-review on the current branch diff against main. Report only concrete findings, include severity and file:line references, include a concrete suggested fix where needed, and stay read-only.",
  "scoring": {
    "weights": {
      "route": 0.2,
      "process": 0.3,
      "outcome": 0.5
    }
  },
  "expected": [
    {
      "id": "deep-review-format",
      "description": "Uses the deep review output format",
      "dimension": "route",
      "type": "output-contains",
      "outputIncludes": [
        "# Deep Review",
        "## Findings",
        "## Audit Tables"
      ]
    },
    {
      "id": "refund-finding-structured",
      "description": "Flags the risky refund diff with severity, file:line, and issue context",
      "dimension": "outcome",
      "type": "reported-context",
      "file": "src/payments/refund.js",
      "contextMatches": [
        "/src\\/payments\\/refund\\.js:3\\b/i"
      ],
      "contextMatchesAny": [
        "/high/i",
        "/critical/i",
        "/sql injection/i",
        "/interpolation/i",
        "/unsafe query/i"
      ]
    },
    {
      "id": "fix-snippet-present",
      "description": "Includes a concrete code fix suggestion in the same finding block",
      "dimension": "process",
      "type": "reported-context",
      "file": "src/payments/refund.js",
      "contextMatches": [
        "/src\\/payments\\/refund\\.js:3\\b/i",
        "/suggestion/i"
      ],
      "contextMatchesAny": [
        "/```[\\s\\S]+```/"
      ]
    }
  ],
  "falsePositives": [
    {
      "id": "workspace-clean",
      "description": "Should stay read-only during deep review",
      "dimension": "process",
      "type": "workspace-clean"
    },
    {
      "id": "no-clean-bill",
      "description": "Should not claim that no issues were found",
      "dimension": "outcome",
      "type": "output-contains",
      "outputIncludes": [
        "No issues found"
      ]
    }
  ]
}
