{
  "name": "@cj-ways/arcana",
  "version": "1.10.0",
  "description": "Curated developer workflow skills for Claude Code and Codex CLI — hand-authored skills backed by SkillsBench data.",
  "bin": {
    "arcana": "bin/arcana.js"
  },
  "type": "module",
  "scripts": {
    "eval:gate": "node evals/run-eval.js --run --runs 3 --write-scorecards --gate-scorecards",
    "eval:boundaries": "node evals/run-trigger-boundary.js --run --runs 3",
    "eval:imports": "node evals/run-import-adaptation.js",
    "eval:release-summary": "node evals/build-release-summary.js",
    "eval:scorecards": "node evals/run-eval.js --run --runs 3 --write-scorecards",
    "eval:triggers": "node evals/run-trigger-eval.js --run --runs 3",
    "generate:docs": "node scripts/sync-generated-content.js",
    "new:skill": "node scripts/new-skill.js",
    "verify:drift": "node scripts/sync-generated-content.js --check",
    "test": "SKIP_NETWORK_TESTS=1 vitest run && npm run verify:drift && node scripts/run-smoke.js && node scripts/run-package-smoke.js",
    "test:package": "node scripts/run-package-smoke.js",
    "test:smoke": "node scripts/run-smoke.js",
    "test:unit": "SKIP_NETWORK_TESTS=1 vitest run && npm run verify:drift",
    "test:network": "vitest run tests/import.test.js",
    "test:watch": "vitest"
  },
  "keywords": [
    "arcana",
    "agent-skills",
    "claude-code",
    "codex",
    "skills",
    "multi-agent",
    "cli"
  ],
  "author": "cj-ways",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cj-ways/arcana.git"
  },
  "homepage": "https://github.com/cj-ways/arcana#readme",
  "bugs": {
    "url": "https://github.com/cj-ways/arcana/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "fs-extra": "^11.3.0",
    "inquirer": "^12.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "agents/",
    "rules/",
    ".claude-plugin/",
    "migrations.json",
    "SKILL-AUTHORING-REFERENCE.md",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "vitest": "^4.1.0"
  }
}
